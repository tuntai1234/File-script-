local Camera   = workspace.CurrentCamera
local espGui   = Instance.new("ScreenGui")
espGui.Name    = "ESPGui"; espGui.ResetOnSpawn=false
espGui.DisplayOrder = 999  -- ← cao nhất để không bị che
espGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
espGui.Parent  = CoreGui

local espEnabled  = false
local nameEnabled = false
local boxEnabled  = false
local lineEnabled = false
local hlEnabled   = false
local espColor    = Color3.fromRGB(255,60,60)
local teamCheck   = false
local espObjects  = {}

local function GetTeamColor(plr)
    if plr.Team then return plr.TeamColor.Color end
    return espColor
end
local function ShouldSkip(plr)
    if plr==LocalPlayer then return true end
    if teamCheck and plr.Team==LocalPlayer.Team then return true end
    return false
end

local function CreateESP(plr)
    if espObjects[plr] then return end
    local obj = {}

    -- Highlight
    local hl = Instance.new("Highlight")
    hl.FillColor=espColor; hl.OutlineColor=espColor
    hl.FillTransparency=0.6; hl.OutlineTransparency=0
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Enabled=hlEnabled
    obj.highlight=hl

    -- Billboard
    local bb = Instance.new("BillboardGui")
    bb.AlwaysOnTop=true; bb.Size=UDim2.new(0,120,0,40)
    bb.StudsOffset=Vector3.new(0,3,0); bb.Enabled=nameEnabled
    local nl=Instance.new("TextLabel",bb); nl.Size=UDim2.new(1,0,0.6,0)
    nl.BackgroundTransparency=1; nl.Text=plr.Name; nl.TextColor3=espColor
    nl.TextSize=13; nl.Font=Enum.Font.GothamBold
    nl.TextStrokeTransparency=0; nl.TextStrokeColor3=Color3.fromRGB(0,0,0)
    local dl=Instance.new("TextLabel",bb); dl.Size=UDim2.new(1,0,0.4,0)
    dl.Position=UDim2.new(0,0,0.6,0); dl.BackgroundTransparency=1; dl.Text=""
    dl.TextColor3=Color3.fromRGB(255,220,100); dl.TextSize=11; dl.Font=Enum.Font.Gotham
    dl.TextStrokeTransparency=0; dl.TextStrokeColor3=Color3.fromRGB(0,0,0)
    obj.billboard=bb; obj.nameLbl=nl; obj.distLbl=dl

    -- Box (4 viền riêng biệt)
    local box=Instance.new("Frame",espGui)
    box.BackgroundTransparency=1; box.BorderSizePixel=0; box.Visible=false
    box.ZIndex=10
    local function MkEdge()
        local f=Instance.new("Frame",box)
        f.BackgroundColor3=espColor; f.BorderSizePixel=0; f.ZIndex=11
        return f
    end
    local eT=MkEdge(); local eB=MkEdge(); local eL=MkEdge(); local eR=MkEdge()
    obj.box=box; obj.edges={eT,eB,eL,eR}

    -- Tracer
    local line=Instance.new("Frame",espGui)
    line.BackgroundColor3=espColor; line.BorderSizePixel=0
    line.AnchorPoint=Vector2.new(0.5,0); line.Visible=false; line.ZIndex=10
    obj.line=line

    espObjects[plr]=obj

    local function Attach(ch)
        if not ch then return end
        local hrp=ch:FindFirstChild("HumanoidRootPart")
        if hrp then hl.Parent=ch; bb.Adornee=hrp; bb.Parent=hrp end
    end
    Attach(plr.Character)
    plr.CharacterAdded:Connect(Attach)
end

local function RemoveESP(plr)
    local obj=espObjects[plr]; if not obj then return end
    if obj.highlight and obj.highlight.Parent then obj.highlight:Destroy() end
    if obj.billboard and obj.billboard.Parent then obj.billboard:Destroy() end
    if obj.box  then obj.box:Destroy()  end
    if obj.line then obj.line:Destroy() end
    espObjects[plr]=nil
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    local myChar=LocalPlayer.Character
    local myHRP=myChar and myChar:FindFirstChild("HumanoidRootPart")
    local vp=Camera.ViewportSize

    for plr,obj in pairs(espObjects) do
        if not plr or not plr.Parent then RemoveESP(plr); continue end
        if ShouldSkip(plr) then continue end

        local ch=plr.Character
        local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
        local head=ch and ch:FindFirstChild("Head")

        local dist=0
        if myHRP and hrp then dist=math.floor((hrp.Position-myHRP.Position).Magnitude) end

        if obj.nameLbl then obj.nameLbl.TextColor3=teamCheck and GetTeamColor(plr) or espColor end
        if obj.distLbl and hrp then obj.distLbl.Text=dist.."m" end
        if obj.billboard then obj.billboard.Enabled=nameEnabled and hrp~=nil end
        if obj.highlight then
            obj.highlight.Enabled=hlEnabled and ch~=nil
            local col=teamCheck and GetTeamColor(plr) or espColor
            obj.highlight.FillColor=col; obj.highlight.OutlineColor=col
        end

        if hrp and head then
            -- Lấy tọa độ viewport
            local hV = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
            local fV = Camera:WorldToViewportPoint(hrp.Position  - Vector3.new(0,3.2,0))
            local rV = Camera:WorldToViewportPoint(hrp.Position)

            if hV.Z > 0 and fV.Z > 0 then
                local col = teamCheck and GetTeamColor(plr) or espColor

                -- BOX
                if boxEnabled then
                    local top  = math.min(hV.Y, fV.Y)
                    local bot  = math.max(hV.Y, fV.Y)
                    local h2d  = math.max(bot-top, 8)
                    local w2d  = math.max(h2d*0.5, 12)
                    local lx   = rV.X - w2d/2

                    obj.box.Position = UDim2.fromOffset(lx, top)
                    obj.box.Size     = UDim2.fromOffset(w2d, h2d)

                    local eT,eB,eL,eR = obj.edges[1],obj.edges[2],obj.edges[3],obj.edges[4]
                    -- Top
                    eT.Position=UDim2.fromOffset(0,0);       eT.Size=UDim2.fromOffset(w2d,2)
                    -- Bottom
                    eB.Position=UDim2.fromOffset(0,h2d-2);   eB.Size=UDim2.fromOffset(w2d,2)
                    -- Left
                    eL.Position=UDim2.fromOffset(0,0);       eL.Size=UDim2.fromOffset(2,h2d)
                    -- Right
                    eR.Position=UDim2.fromOffset(w2d-2,0);   eR.Size=UDim2.fromOffset(2,h2d)

                    for _,e in ipairs(obj.edges) do e.BackgroundColor3=col end
                    obj.box.Visible=true
                else
                    obj.box.Visible=false
                end

                -- TRACER
                if lineEnabled then
                    local sx = vp.X/2
                    local sy = vp.Y
                    local dx = fV.X - sx
                    local dy = fV.Y - sy
                    local len = math.sqrt(dx*dx + dy*dy)
                    if len > 1 then
                        obj.line.Position  = UDim2.fromOffset(sx, sy)
                        obj.line.Size      = UDim2.fromOffset(2, len)
                        obj.line.Rotation  = math.deg(math.atan2(dy,dx)) + 90
                        obj.line.BackgroundColor3 = col
                        obj.line.Visible   = true
                    end
                else
                    obj.line.Visible=false
                end
            else
                obj.box.Visible=false; obj.line.Visible=false
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(plr)
    if espEnabled and not ShouldSkip(plr) then CreateESP(plr) end
end)
Players.PlayerRemoving:Connect(function(plr) RemoveESP(plr) end)

local function ToggleAllESP(val)
    espEnabled=val
    if val then
        for _,plr in ipairs(Players:GetPlayers()) do
            if not ShouldSkip(plr) then CreateESP(plr) end
        end
    else
        for plr in pairs(espObjects) do RemoveESP(plr) end
    end
end

