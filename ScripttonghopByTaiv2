local function MkFlyBtn(parent, text, x, y, w, h, onDown, onUp)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0,w,0,h); btn.Position = UDim2.new(0,x,0,y)
    btn.BackgroundColor3 = Color3.fromRGB(30,30,50); btn.BackgroundTransparency = 0.35
