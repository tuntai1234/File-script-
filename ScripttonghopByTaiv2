local AimTab = Window:AddTab({ Title = "Aim Bot", Icon = "target" })

-- Khởi tạo POV Circle
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Thickness = 1.5
FOVCircle.Radius = 100
FOVCircle.Color = Color3.fromRGB(0, 255, 0)
FOVCircle.Filled = false
FOVCircle.Transparency = 1
FOVCircle.ZIndex = 999

-- Biến cấu hình
local AimEnabled, POVEnabled = false, false
local AimTarget = "All"
local TargetPart = "Head"
local Smoothness = 0.1
local R6Parts = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}

-- Hàm tìm mục tiêu gần nhất
local function GetClosestTarget()
    local closestPlayer = nil
    local shortestDistance = math.huge
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild(TargetPart) then
            if AimTarget == "All" or plr.Name == AimTarget then
                local part = plr.Character[TargetPart]
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                
                -- Chỉ aim vào người trong vòng tròn POV
                if onScreen and dist < FOVCircle.Radius then
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestPlayer = plr
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Vòng lặp cập nhật Aim
RunService.RenderStepped:Connect(function()
    -- Cập nhật POV vị trí
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    FOVCircle.Visible = POVEnabled
    
    -- Thực hiện Aim
    if AimEnabled then
        local target = GetClosestTarget()
        if target and target.Character:FindFirstChild(TargetPart) then
            local targetPos = target.Character[TargetPart].Position
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), Smoothness)
        end
    end
end)

