-- ================================================================
-- HITBOX
-- ================================================================
local hbEnabled      = false
local hbSize         = 10
local hbVisible      = false
local hbColor        = Color3.fromRGB(0, 100, 255)
local hbTransparency = 0.5
local hbPlayers      = {}

-- Lưu size gốc để restore
local hbOrigSize = {}

local function GetHBPlayers()
    hbPlayers = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character
        and plr.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(hbPlayers, plr)
        end
    end
end

-- Restore tất cả hitbox về gốc
local function RestoreHitbox()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local orig = hbOrigSize[plr]
                if orig then
                    hrp.Size        = orig.size
                    hrp.Transparency= orig.trans
                    hrp.CanCollide  = orig.collide
                else
                    hrp.Size        = Vector3.new(2, 2, 1)
                    hrp.Transparency= 1
                    hrp.CanCollide  = false
                end
            end
        end
    end
    hbOrigSize = {}
end

-- RenderStepped update hitbox
local hbConn = nil

local function StartHitbox()
    GetHBPlayers()
    -- Lưu size gốc
    for _, plr in ipairs(hbPlayers) do
        local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp and not hbOrigSize[plr] then
            hbOrigSize[plr] = {
                size    = hrp.Size,
                trans   = hrp.Transparency,
                collide = hrp.CanCollide,
            }
        end
    end
    hbConn = RunService.RenderStepped:Connect(function()
        for _, plr in ipairs(hbPlayers) do
            if plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Size       = Vector3.new(hbSize, hbSize, hbSize)
                    hrp.CanCollide = false
                    if hbVisible then
                        hrp.Transparency = hbTransparency
                        hrp.Material     = Enum.Material.Neon
                        hrp.Color        = hbColor
                    else
                        hrp.Transparency = 1
                    end
                end
            end
        end
    end)
end

local function StopHitbox()
    if hbConn then hbConn:Disconnect(); hbConn=nil end
    RestoreHitbox()
end

-- Refresh player list mỗi 3s
task.spawn(function()
    while true do
        task.wait(3)
        if hbEnabled then GetHBPlayers() end
    end
end)

